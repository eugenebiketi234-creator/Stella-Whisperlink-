/* ══════ SPLASH ══════ */
/* ── Reset ── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0; padding: 0;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
  touch-action: manipulation;
}

/* ── Root ── */
html, body {
  width: 100%;
  height: 100%;
  background: #04050d;
  overflow: hidden;
}

/* ══════════════════════════════════════════
   SPLASH SCREEN
══════════════════════════════════════════ */
#splash {
  position: relative;
  width: 100vw;
  height: 100dvh;
  height: 100vh;
  background: #04050d;
  overflow-x: hidden;
  overflow-y: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ══════════════════════════════════════════
   LAYER 1 — CONTENT
   z-index: 10
   Anchored from top — floating in space
══════════════════════════════════════════ */
.splash-content {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding-top: clamp(60px, 10vh, 90px);
}

/* ── Logo Block ── */
.splash-logo-wrap {
  position: relative;
  width: 220px;
  height: 220px;
  flex-shrink: 0;
  margin-bottom: 36px;
  opacity: 0;
  will-change: transform, opacity;
  transform: translateZ(0);
  backface-visibility: hidden;
  animation: logoIn 0.8s cubic-bezier(.34,1.56,.64,1) 0.2s forwards;
}

/* Rings — all centered */
.splash-ring {
  position: absolute;
  border-radius: 50%;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
}
.splash-ring-1 {
  width: 148px; height: 148px;
  border: 1px solid rgba(0,229,255,0.22);
}
.splash-ring-2 {
  width: 184px; height: 184px;
  border: 1px solid rgba(0,229,255,0.11);
}
.splash-ring-3 {
  width: 220px; height: 220px;
  border: 1px solid rgba(0,229,255,0.05);
}

/* Inner circle */
.splash-circle {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 110px; height: 110px;
  border-radius: 50%;
  border: 2.5px solid #00e5ff;
  background: radial-gradient(circle,
    rgba(0,229,255,0.08) 0%,
    rgba(2,5,16,0.96) 70%);
  box-shadow:
    0 0 28px rgba(0,229,255,0.50),
    0 0 55px rgba(0,229,255,0.16),
    inset 0 0 22px rgba(0,229,255,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  will-change: box-shadow;
  transform: translate(-50%, -50%) translateZ(0);
  animation: orbPulse 2.5s ease-in-out infinite;
}

/* Star SVG */
.splash-star {
  width: 50px; height: 50px;
  color: #00e5ff;
  filter:
    drop-shadow(0 0 8px rgba(0,229,255,0.7))
    drop-shadow(0 0 18px rgba(0,229,255,0.35));
  position: relative;
  z-index: 2;
  flex-shrink: 0;
}

/* ── Text Block ── */
.splash-stella {
  font-family: 'Syne', sans-serif;
  font-weight: 800;
  font-size: clamp(18px, 5.5vw, 28px);
  letter-spacing: 3px;
  color: #ffffff;
  text-align: center;
  margin-bottom: 2px;
  opacity: 0;
  animation: fadeUp 0.7s ease-out 0.9s forwards;
}

.splash-whisperlink {
  font-family: 'Syne', sans-serif;
  font-weight: 800;
  font-size: clamp(18px, 6.5vw, 34px);
  letter-spacing: 0.5px;
  font-feature-settings: "kern" 1;
  -webkit-font-feature-settings: "kern" 1;
  background: linear-gradient(90deg, #00e5ff 0%, #7c3aed 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-align: center;
  display: block;
  width: 100%;
  max-width: calc(100vw - 48px);
  padding: 0 24px;
  overflow: hidden;
  white-space: nowrap;
  margin-bottom: 8px;
  opacity: 0;
  animation: fadeUp 0.7s ease-out 0.9s forwards;
}

.splash-version {
  font-family: 'Share Tech Mono', monospace;
  font-size: 11px;
  letter-spacing: 4px;
  color: rgba(255,255,255,0.32);
  text-align: center;
  margin-bottom: 28px;
  opacity: 0;
  animation: fadeIn 0.3s ease 1.5s forwards;
}

/* ── Progress Bar ── */
.splash-bar-wrap {
  width: min(240px, 72vw);
  margin: 0 auto;
  margin-bottom: 36px;
  opacity: 0;
  animation: fadeIn 0.3s ease 1.2s forwards;
}
.splash-bar-track {
  width: 100%;
  height: 2px;
  background: rgba(255,255,255,0.06);
  border-radius: 2px;
  overflow: hidden;
}
.splash-bar-fill {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #6366f1 0%, #00e5ff 100%);
  border-radius: 2px;
  box-shadow: 0 0 8px rgba(0,229,255,0.6);
  will-change: width;
  transform: translateZ(0);
  animation: barLoad 1.4s linear 1.3s forwards;
}

/* ── Tagline ── */
.splash-tagline {
  text-align: center;
  line-height: 1.45;
  letter-spacing: 0;
  opacity: 0;
  animation: taglineIn 0.6s ease-out 3.5s forwards;
}
.splash-tagline-l1,
.splash-tagline-l2 {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-weight: 400;
  font-size: clamp(14px, 4vw, 17px);
  color: rgba(255,255,255,0.82);
}
.splash-tagline-l2 em {
  font-style: normal;
  color: #00e5ff;
  text-shadow: 0 0 12px rgba(0,229,255,0.55);
}

/* ══════════════════════════════════════════
   LAYER 2 — DOME
   z-index: 5
   Fixed to bottom — purely atmospheric
══════════════════════════════════════════ */
.splash-dome {
  position: absolute;
  bottom: 0;
  left: 0; right: 0;
  height: 200px;
  z-index: 5;
  overflow: visible;
  pointer-events: none;
  background: transparent;
  opacity: 0;
  animation: fadeIn 0.8s ease 2.0s forwards;
}

/* Arc — atmospheric, no hard line, no fill */
.splash-dome-arc {
  position: absolute;
  bottom: -300px;
  left: 50%;
  transform: translateX(-50%);
  width: 150vw;
  height: 400px;
  border-radius: 50%;
  border: none;
  background: transparent;
  box-shadow:
    0 0 40px 10px rgba(0,229,255,0.18),
    0 0 80px 25px rgba(99,102,241,0.10),
    0 0 130px 50px rgba(124,58,237,0.06);
}

/* Glow bloom — purely radial, no fill */
.splash-dome-glow {
  position: absolute;
  bottom: 0;
  left: 0; right: 0;
  height: 200px;
  background: radial-gradient(ellipse 80% 100% at 50% 100%,
    rgba(0,229,255,0.18)  0%,
    rgba(99,102,241,0.10) 40%,
    rgba(124,58,237,0.06) 65%,
    transparent           82%);
  mix-blend-mode: screen;
  animation: domeGlowPulse 3s ease-in-out infinite;
}

/* Beam — environmental, not a feature */
.splash-dome-beam {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 1px;
  height: 140px;
  background: linear-gradient(to top,
    rgba(255,255,255,0.35) 0%,
    rgba(0,229,255,0.18)   30%,
    rgba(0,229,255,0.05)   65%,
    transparent            100%);
  box-shadow: 0 0 6px rgba(0,229,255,0.5);
}

/* ══════════════════════════════════════════
   BY STELLA TECH — z-index: 20
══════════════════════════════════════════ */
.splash-byline {
  position: fixed;
  bottom: 18px;
  left: 0; right: 0;
  text-align: center;
  font-family: 'Share Tech Mono', monospace;
  font-size: 11px;
  letter-spacing: 3px;
  color: rgba(255,255,255,0.85);
  z-index: 20;
  opacity: 0;
  animation: fadeIn 0.6s ease 4.2s forwards;
}

/* ══════════════════════════════════════════
   KEYFRAMES
══════════════════════════════════════════ */
@keyframes logoIn {
  from { opacity: 0; transform: scale(0.7) translateZ(0); }
  to   { opacity: 1; transform: scale(1) translateZ(0); }
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes taglineIn {
  from { opacity: 0; transform: translateY(14px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes barLoad {
  0%   { width: 0%; }
  100% { width: 100%; }
}
@keyframes orbPulse {
  0%, 100% {
    box-shadow:
      0 0 28px rgba(0,229,255,0.50),
      0 0 55px rgba(0,229,255,0.16),
      inset 0 0 22px rgba(0,229,255,0.06);
  }
  50% {
    box-shadow:
      0 0 40px rgba(0,229,255,0.70),
      0 0 75px rgba(0,229,255,0.24),
      inset 0 0 30px rgba(0,229,255,0.10);
  }
}
@keyframes domeGlowPulse {
  0%, 100% { opacity: 0.8; }
  50%       { opacity: 1.0; }
}

/* ══════════════════════════════════════════
   SHORT SCREEN BREAKPOINT — max-height 650px
══════════════════════════════════════════ */
@media (max-height: 650px) {
  .splash-content     { padding-top: 60px; }
  .splash-logo-wrap   { width:180px; height:180px; margin-bottom:20px; }
  .splash-circle      { width:90px; height:90px; }
  .splash-ring-1      { width:120px; height:120px; }
  .splash-ring-2      { width:150px; height:150px; }
  .splash-ring-3      { width:180px; height:180px; }
  .splash-star        { width:42px; height:42px; }
  .splash-bar-wrap    { margin-bottom:24px; }
  .splash-tagline-l1,
  .splash-tagline-l2  { font-size:13px; }
}

/* ══════════════════════════════════════════
   REDUCED MOTION
══════════════════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  .splash-logo-wrap,
  .splash-stella,
  .splash-whisperlink,
  .splash-version,
  .splash-bar-wrap,
  .splash-tagline,
  .splash-byline,
  .splash-dome {
    animation-duration: 0.01ms !important;
    animation-delay: 0ms !important;
    opacity: 1 !important;
  }
}
/* ══════ AUTH ══════ */
/* ── Reset ── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0; padding: 0;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
  touch-action: manipulation;
}

/* ── Root ── */
html, body {
  width: 100%; height: 100%;
  background: #04050d;
  overflow: hidden;
  font-family: 'Plus Jakarta Sans', sans-serif;
}

/* ══════════════════════════════════════════
   AUTH SCREEN
══════════════════════════════════════════ */
#auth {
  position: relative;
  width: 100vw;
  height: 100dvh;
  height: 100vh;
  background: #04050d;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* ── Atmospheric dome glow — carried from splash ── */
.auth-dome-glow {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: 260px;
  background: radial-gradient(ellipse 80% 100% at 50% 100%,
    rgba(0,229,255,0.11)  0%,
    rgba(99,102,241,0.06) 40%,
    rgba(124,58,237,0.04) 65%,
    transparent           82%);
  pointer-events: none;
  z-index: 1;
}

/* ══════════════════════════════════════════
   CONTENT — z-index 10
══════════════════════════════════════════ */
.auth-content {
  position: relative;
  z-index: 10;
  width: 100%;
  max-width: 340px;
  padding: 0 28px;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: authIn 0.6s cubic-bezier(.34,1.56,.64,1) 0.1s both;
}

@keyframes authIn {
  from { opacity: 0; transform: translateY(18px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── Logo — smaller, quieter than splash ── */
.auth-logo-wrap {
  position: relative;
  width: 120px; height: 120px;
  margin-bottom: 14px;
  flex-shrink: 0;
}
.auth-ring {
  position: absolute;
  border-radius: 50%;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
}
.auth-ring-1 { width:80px;  height:80px;  border: 1px solid rgba(0,229,255,0.19); }
.auth-ring-2 { width:100px; height:100px; border: 1px solid rgba(0,229,255,0.09); }
.auth-ring-3 { width:120px; height:120px; border: 1px solid rgba(0,229,255,0.04); }
.auth-circle {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 64px; height: 64px;
  border-radius: 50%;
  border: 2px solid #00e5ff;
  background: radial-gradient(circle,
    rgba(0,229,255,0.08) 0%,
    rgba(2,5,16,0.96) 70%);
  box-shadow:
    0 0 20px rgba(0,229,255,0.42),
    0 0 42px rgba(0,229,255,0.14),
    inset 0 0 16px rgba(0,229,255,0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: orbPulse 2.5s ease-in-out infinite;
}
.auth-star {
  width: 28px; height: 28px;
  color: #00e5ff;
  filter:
    drop-shadow(0 0 6px rgba(0,229,255,0.7))
    drop-shadow(0 0 14px rgba(0,229,255,0.3));
  flex-shrink: 0;
}

/* ── Title block ── */
.auth-title {
  font-family: 'Syne', sans-serif;
  font-weight: 800;
  font-size: clamp(20px, 6vw, 28px);
  letter-spacing: 0.5px;
  background: linear-gradient(90deg, #00e5ff 0%, #7c3aed 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-align: center;
  margin-bottom: 6px;
  font-feature-settings: "kern" 1;
}
.auth-subtitle {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 13px;
  font-weight: 400;
  color: rgba(255,255,255,0.55);
  text-align: center;
  letter-spacing: 0;
  margin-bottom: 28px;
}

/* ── Form ── */
.auth-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* Field group */
.auth-field {
  display: flex;
  flex-direction: column;
  margin-bottom: 14px;
}
.auth-label {
  font-family: 'Share Tech Mono', monospace;
  font-size: 10px;
  letter-spacing: 2px;
  color: rgba(0,229,255,0.8);
  margin-bottom: 8px;
  text-transform: uppercase;
}
.auth-field-note {
  font-family: 'Share Tech Mono', monospace;
  font-size: 9px;
  letter-spacing: 1px;
  color: rgba(0,229,255,0.5);
  margin-bottom: 6px;
}

/* Input wrapper — for icon positioning */
.auth-input-wrap {
  position: relative;
}
.auth-input-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  width: 18px; height: 18px;
  color: rgba(0,229,255,0.4);
  pointer-events: none;
  transition: color 0.2s ease;
}

/* Input shared style */
.auth-input {
  width: 100%;
  height: 52px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(0,229,255,0.15);
  border-radius: 8px;
  color: #ffffff;
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 15px;
  font-weight: 400;
  outline: none;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
  padding: 0 16px 0 44px;
}
.auth-input::placeholder {
  color: rgba(255,255,255,0.22);
}

/* Focus states */
.auth-input:focus {
  border-color: rgba(0,229,255,0.55);
  box-shadow: 0 0 0 3px rgba(0,229,255,0.08);
}
.auth-input:focus + .auth-input-icon,
.auth-input-wrap:focus-within .auth-input-icon {
  color: rgba(0,229,255,0.7);
}

/* Error state */
.auth-input.error {
  border-color: rgba(239,68,68,0.7);
  box-shadow: 0 0 0 3px rgba(239,68,68,0.08);
}
.auth-err {
  font-family: 'Share Tech Mono', monospace;
  font-size: 10px;
  letter-spacing: 1px;
  color: rgba(239,68,68,0.85);
  margin-top: 6px;
  min-height: 16px;
  display: none;
}
.auth-err.visible {
  display: block;
}

/* ── Custom Language Selector ── */
.custom-lang-selector {
  position: relative;
  width: 100%;
}

.lang-trigger {
  width: 100%;
  height: 52px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(0,229,255,0.15);
  border-radius: 8px;
  color: #ffffff;
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 15px;
  font-weight: 400;
  outline: none;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
  cursor: pointer;
  display: flex;
  align-items: center;
  padding: 0 14px;
  gap: 12px;
  position: relative;
}

.lang-trigger:hover {
  border-color: rgba(0,229,255,0.25);
}

.lang-trigger.open {
  border-color: rgba(0,229,255,0.55);
  box-shadow: 0 0 0 3px rgba(0,229,255,0.08);
}

.lang-trigger-icon {
  width: 18px;
  height: 18px;
  color: rgba(0,229,255,0.4);
  flex-shrink: 0;
}

.lang-trigger-text {
  flex: 1;
  text-align: left;
  color: rgba(255,255,255,0.22);
}

.lang-trigger-text.selected {
  color: #ffffff;
}

.lang-trigger-chevron {
  width: 16px;
  height: 16px;
  color: rgba(0,229,255,0.5);
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.lang-trigger.open .lang-trigger-chevron {
  transform: rotate(180deg);
}

.lang-dropdown {
  position: fixed;
  background: rgba(4,5,13,0.97);
  border: 1px solid rgba(0,229,255,0.18);
  border-radius: 8px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.6);
  z-index: 1000;
  max-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  opacity: 0;
  transition: max-height 0.3s ease, opacity 0.3s ease;
  display: none;
  min-width: 280px;
}

.lang-dropdown.open {
  display: block;
  max-height: 380px;
  opacity: 1;
}

/* Custom scrollbar */
.lang-dropdown::-webkit-scrollbar {
  width: 4px;
}

.lang-dropdown::-webkit-scrollbar-track {
  background: transparent;
}

.lang-dropdown::-webkit-scrollbar-thumb {
  background: rgba(0,229,255,0.3);
  border-radius: 2px;
}

.lang-section-header {
  font-family: 'Share Tech Mono', monospace;
  font-size: 10px;
  letter-spacing: 2px;
  text-transform: uppercase;
  padding: 10px 14px 6px;
  color: rgba(0,229,255,0.9);
  position: sticky;
  top: 0;
  background: rgba(4,5,13,0.98);
  z-index: 10;
}

.lang-section-header.tier2 {
  color: rgba(255,255,255,0.35);
}

.lang-divider {
  height: 1px;
  background: rgba(0,229,255,0.08);
  margin: 0;
}

.lang-option {
  height: 44px;
  padding: 0 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  transition: background 0.15s ease;
  color: #ffffff;
  font-size: 14px;
}

.lang-option:hover {
  background: rgba(0,229,255,0.06);
}

.lang-option.tier2 {
  height: 40px;
  color: rgba(255,255,255,0.75);
}

.lang-option.tier2:hover {
  background: rgba(255,255,255,0.04);
}

.lang-option-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.lang-option-star {
  color: #00e5ff;
  font-size: 14px;
}

.lang-option-badges {
  display: flex;
  gap: 6px;
}

.lang-badge {
  background: rgba(0,229,255,0.1);
  border: 1px solid rgba(0,229,255,0.2);
  color: rgba(0,229,255,0.8);
  font-size: 9px;
  padding: 2px 6px;
  border-radius: 4px;
  font-family: 'Plus Jakarta Sans', sans-serif;
}

/* Hidden input for form submission */
#li-lang {
  display: none;
}

/* ── Button ── */
.auth-btn {
  width: 100%;
  height: 52px;
  margin-top: 24px;
  background: linear-gradient(135deg, #6366f1 0%, #00e5ff 100%);
  border: none;
  border-radius: 8px;
  color: #04050d;
  font-family: 'Share Tech Mono', monospace;
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 2px;
  cursor: pointer;
  box-shadow:
    0 0 8px rgba(0,229,255,0.12),
    0 2px 12px rgba(99,102,241,0.18);
  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease,
    opacity 0.15s ease;
  position: relative;
  overflow: hidden;
}
.auth-btn:active {
  transform: scale(0.98);
  box-shadow: 0 0 4px rgba(0,229,255,0.08);
}
.auth-btn.setting-up {
  opacity: 0.75;
  pointer-events: none;
}

/* ══════════════════════════════════════════
   KEYFRAMES
══════════════════════════════════════════ */
@keyframes orbPulse {
  0%, 100% {
    box-shadow:
      0 0 20px rgba(0,229,255,0.42),
      0 0 42px rgba(0,229,255,0.14),
      inset 0 0 16px rgba(0,229,255,0.05);
  }
  50% {
    box-shadow:
      0 0 28px rgba(0,229,255,0.60),
      0 0 55px rgba(0,229,255,0.20),
      inset 0 0 22px rgba(0,229,255,0.09);
  }
}

