/* ══════ ONBOARDING ══════ */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0; padding: 0;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}
html, body {
  width: 100%; height: 100%;
  background: #04050d;
  overflow: hidden;
  font-family: 'Plus Jakarta Sans', sans-serif;
}

/* ── Container ── */
#onboard {
  position: relative;
  width: 100vw;
  height: 100dvh;
  height: 100vh;
  background: #04050d;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
}

/* Atmospheric glow */
.ob-bg-glow {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: 260px;
  background: radial-gradient(ellipse 80% 100% at 50% 100%,
    rgba(0,229,255,0.10)  0%,
    rgba(99,102,241,0.06) 40%,
    rgba(124,58,237,0.03) 65%,
    transparent           82%);
  pointer-events: none;
  z-index: 1;
}

/* Top star */
.ob-star-top {
  position: fixed;
  top: 32px; left: 50%;
  transform: translateX(-50%);
  z-index: 30;
  width: 36px; height: 36px;
  border-radius: 50%;
  border: 1.5px solid #00e5ff;
  background: radial-gradient(circle, rgba(0,229,255,0.1) 0%, rgba(2,5,16,0.95) 70%);
  box-shadow: 0 0 10px rgba(0,229,255,0.4), 0 0 22px rgba(0,229,255,0.15);
  display: flex; align-items: center; justify-content: center;
}
.ob-star-top svg {
  width: 16px; height: 16px;
  color: #00e5ff;
  filter: drop-shadow(0 0 4px rgba(0,229,255,0.7));
}

/* Screen shell */
.ob-screen {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 88px 32px 96px;
  opacity: 0;
  pointer-events: none;
}
.ob-screen.ob-active {
  opacity: 1;
  pointer-events: none; /* tap handled by container */
  animation: obEnter 0.4s ease forwards;
}
@keyframes obEnter {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Icon block */
.ob-icon-wrap {
  position: relative;
  width: 160px; height: 160px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36px;
  flex-shrink: 0;
}
.ob-ring {
  position: absolute;
  border-radius: 50%;
  border: 1.5px solid rgba(0,229,255,0.2);
  top: 50%; left: 50%;
  transform: translate(-50%,-50%) scale(1);
  opacity: 0.5;
  animation: obRingPulse 2s ease-out infinite;
}
.ob-ring-1 { width:90px;  height:90px;  animation-delay:0s; }
.ob-ring-2 { width:120px; height:120px; animation-delay:0.4s; }
.ob-ring-3 { width:150px; height:150px; animation-delay:0.8s; }
#ob-s3 .ob-ring { animation-duration: 1.5s; }
@keyframes obRingPulse {
  0%   { transform:translate(-50%,-50%) scale(1);   opacity:0.5; }
  100% { transform:translate(-50%,-50%) scale(1.3); opacity:0; }
}
.ob-icon-glow {
  position: absolute;
  width: 80px; height: 80px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0,229,255,0.14) 0%, transparent 70%);
  top: 50%; left: 50%;
  transform: translate(-50%,-50%);
}
.ob-icon-main {
  position: relative; z-index: 2;
  width: 48px; height: 48px;
  color: #00e5ff;
  filter: drop-shadow(0 0 6px rgba(0,229,255,0.7)) drop-shadow(0 0 14px rgba(0,229,255,0.3));
}

/* Connection line — screen 2 */
.ob-conn-line {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%,-50%);
  width: 0; height: 1.5px;
  background: linear-gradient(90deg, transparent, #00e5ff, transparent);
  border-radius: 2px;
  box-shadow: 0 0 6px rgba(0,229,255,0.5);
  animation: connLineDraw 0.8s ease 0.3s forwards;
  z-index: 3;
}
@keyframes connLineDraw {
  from { width:0; opacity:0; }
  to   { width:60px; opacity:1; }
}

/* Text */
.ob-body {
  text-align: center;
  width: 100%; max-width: 300px;
}
.ob-headline {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-weight: 700;
  font-size: clamp(22px, 6vw, 28px);
  color: #ffffff;
  letter-spacing: -0.5px;
  line-height: 1.2;
  margin-bottom: 10px;
  min-height: 34px;
  text-transform: none;
}
.ob-sub {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-weight: 400;
  font-size: clamp(14px, 4vw, 16px);
  color: rgba(255,255,255,0.45);
  line-height: 1.5;
  opacity: 0;
  transition: opacity 0.4s ease;
}
.ob-sub.visible { opacity: 1; }

/* Tap hint */
.ob-tap-hint {
  position: fixed;
  bottom: 68px;
  left: 50%; transform: translateX(-50%);
  z-index: 25;
  font-family: 'Share Tech Mono', monospace;
  font-size: 9px;
  letter-spacing: 2px;
  color: rgba(255,255,255,0.22);
  white-space: nowrap;
  transition: opacity 0.3s ease;
}
.ob-tap-hint.hidden { opacity: 0; }

/* Footer — dots + GET STARTED */
.ob-footer {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: calc(env(safe-area-inset-bottom,0px) + 24px);
}
.ob-dots {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 0;
}
.ob-dot {
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  width: 6px; height: 6px;
  transition: all 0.3s ease;
}
.ob-dot.active {
  width: 8px; height: 8px;
  background: #00e5ff;
  box-shadow: 0 0 8px rgba(0,229,255,0.6);
}

/* GET STARTED — screen 3 only */
.ob-btn-wrap {
  width: 100%; max-width: 280px;
  margin-top: 20px;
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.4s ease, transform 0.4s ease;
  pointer-events: none;
}
.ob-btn-wrap.visible {
  opacity: 1; transform: translateY(0);
  pointer-events: auto;
}
.ob-btn {
  width: 100%; height: 52px;
  background: linear-gradient(135deg, #6366f1 0%, #00e5ff 100%);
  border: none; border-radius: 8px;
  color: #04050d;
  font-family: 'Share Tech Mono', monospace;
  font-size: 11px; letter-spacing: 2px;
  cursor: pointer;
  box-shadow: 0 0 8px rgba(0,229,255,0.12), 0 2px 12px rgba(99,102,241,0.18);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.ob-btn:active {
  transform: scale(0.98);
  box-shadow: 0 0 4px rgba(0,229,255,0.08);
}

/* Short screen */
@media (max-height: 650px) {
  .ob-screen    { padding: 76px 28px 80px; }
  .ob-icon-wrap { width:120px; height:120px; margin-bottom:24px; }
  .ob-ring-1    { width:70px;  height:70px; }
  .ob-ring-2    { width:94px;  height:94px; }
  .ob-ring-3    { width:118px; height:118px; }
  .ob-icon-main { width:38px;  height:38px; }
  .ob-headline  { font-size:18px; }
}
@media (prefers-reduced-motion: reduce) {
  .ob-ring      { animation:none; opacity:0.15; }
  .ob-conn-line { animation:none; width:60px; opacity:1; }
  .ob-screen    { animation:none; }
}
